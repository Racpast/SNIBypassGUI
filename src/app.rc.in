#include <winver.h>
#include <winuser.h>

// Application icon. Resolved by bare name through the windres include path set in
// CMakeLists.txt.
1 ICON "icon.ico"

// Embedded manifest requesting administrator privileges.
#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// User agreement, one document per language. These must be readable before any file
// or network access exists, since accepting the agreement gates the first launch.
// The ids match EmbeddedText::kEula* in src/platform/embedded_text.h.
100 RCDATA "eula.en.txt"
101 RCDATA "eula.zh.txt"

// Version information.
//
// GENERATED FROM app.rc.in by CMake -- do not edit the copy in the build tree.
// The numeric version comes verbatim from APP_VERSION_NUM in src/app/version.h
// (strict a.b.c[.d]); CMake splits it into the four components the native
// FILEVERSION resource requires. Display strings use GetVersionDisplayStr().
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @SNIB_VER_A@,@SNIB_VER_B@,@SNIB_VER_C@,@SNIB_VER_D@
 PRODUCTVERSION  @SNIB_VER_A@,@SNIB_VER_B@,@SNIB_VER_C@,@SNIB_VER_D@
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Racpast"
            VALUE "FileDescription",  "SNIBypassGUI"
            VALUE "FileVersion",      "@SNIB_VER_NUMERIC@"
            VALUE "InternalName",     "SNIBypassGUI"
            VALUE "LegalCopyright",   "Copyright (c) Racpast. All rights reserved."
            VALUE "OriginalFilename", "SNIBypassGUI.exe"
            VALUE "ProductName",      "SNIBypassGUI"
            VALUE "ProductVersion",   "@SNIB_VER_NUMERIC@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
